# Copy to .env (gitignored) and fill in. NEVER commit real keys.
# HL_PRIVATE_KEY = API/agent signer key (approve the API wallet on the target network).
# HL_ACCOUNT_ADDRESS = MASTER wallet address (the 0x... that holds funds), NOT the agent.
HL_PRIVATE_KEY=0xYOUR_API_WALLET_PRIVATE_KEY
HL_ACCOUNT_ADDRESS=0xYOUR_MASTER_WALLET_ADDRESS
HL_IS_TESTNET=True

# Optional Telegram alerts (leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
